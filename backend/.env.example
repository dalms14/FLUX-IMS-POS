MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/flux-pos?retryWrites=true&w=majority
CORS_ORIGIN=https://your-vercel-project.vercel.app
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=FLUX Password Reset <onboarding@resend.dev>

# Leave blank while the installation contains only test transactions.
# Set to the first full day of verified client operations after handover.
FORECAST_REAL_SALES_START_DATE=
# Optional confirmed closures: Sunday=0 ... Saturday=6; ISO dates separated by commas.
FORECAST_CLOSED_WEEKDAYS=
FORECAST_CLOSED_DATES=
