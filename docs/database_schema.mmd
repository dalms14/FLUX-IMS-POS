erDiagram
    Category {
        ObjectId _id PK
        String name "required"
    }
    Product {
        ObjectId _id PK
        String name "required"
        Number price "optional"
        Number soloPrice "optional"
        Number platterPrice "optional"
        String category "required"
        ObjectId categoryId FK "ref to Category; optional"
        String description "optional"
        StringArray variants "optional"
        DocumentArray variantGroups "optional"
        DocumentArray addons "optional"
        String image "optional"
        String status "optional"
        Boolean available "optional"
        Boolean archived "optional"
        Date archivedAt "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    Addon {
        ObjectId _id PK
        String name "required"
        String nameKey "required"
        Number price "optional"
        Boolean active "optional"
        Date archivedAt "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    Discount {
        ObjectId _id PK
        String name "required"
        String nameKey "required"
        Number percentage "required"
        String scope "optional"
        Boolean active "optional"
        Date archivedAt "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    Inventory {
        ObjectId _id PK
        String name "required"
        String unit "required"
        Number stock "required"
        Number lowStockAt "optional"
        String category "optional"
        Date expirationDate "optional"
        DocumentArray expirationBatches "optional"
        Boolean archived "optional"
        Date archivedAt "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    Recipe {
        ObjectId _id PK
        ObjectId productId FK "ref to Product; required"
        String productName "required"
        DocumentArray ingredients "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    Transaction {
        ObjectId _id PK
        String receiptNo "required"
        String orderNo "optional"
        String orderStatus "optional"
        Date statusUpdatedAt "optional"
        Date cancelledAt "optional"
        String cancelledBy "optional"
        String cancelReason "optional"
        ObjectId cancellationRefundId FK "ref to Refund; optional"
        DocumentArray cancelledItems "optional"
        String cashier "required"
        String cashierEmail "optional"
        String customerType "optional"
        String serviceType "optional"
        String eliteMember_name "optional"
        String eliteMember_idNumber "optional"
        String discountInfo_name "optional"
        Number discountInfo_percentage "optional"
        String discountInfo_code "optional"
        String discountInfo_scope "optional"
        DocumentArray items "optional"
        Number subtotal "required"
        Number tax "optional"
        Number discount "optional"
        Number total "required"
        String paymentMethod "required"
        Number amountTendered "optional"
        Number change "optional"
        String gcashReference "optional"
        String gcashProofImage "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    Refund {
        ObjectId _id PK
        ObjectId transactionId FK "ref to Transaction; required"
        String receiptNo "required"
        DocumentArray items "optional"
        String reason "required"
        Number subtotal "required"
        Number tax "optional"
        Number totalRefunded "required"
        String refundedBy "required"
        String refundedByEmail "optional"
        String paymentMethod "required"
        String status "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    Waste {
        ObjectId _id PK
        ObjectId refundId FK "ref to Refund; required"
        ObjectId transactionId FK "ref to Transaction; required"
        String receiptNo "required"
        DocumentArray items "optional"
        String reason "optional"
        String disposedBy "required"
        String notes "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    User {
        ObjectId _id PK
        String name "optional"
        String email "optional"
        String password "optional"
        Boolean mustChangePassword "optional"
        String firstLoginTokenHash "optional"
        Date firstLoginTokenExpiresAt "optional"
        String role "optional"
        String jobRole "optional"
        StringArray permissions "optional"
        String pin "optional"
        String profileImage "optional"
        Boolean isOnline "optional"
        Date lastSeenAt "optional"
        Boolean archived "optional"
        Date archivedAt "optional"
        String passwordResetOtpHash "optional"
        Date passwordResetOtpExpiresAt "optional"
        Number passwordResetOtpAttempts "optional"
        Date passwordResetOtpUsedAt "optional"
        String userId "required"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    PurchaseOrder {
        ObjectId _id PK
        String purchaseOrderNo "required"
        String supplierName "required"
        String supplierContact "optional"
        Date orderDate "optional"
        Date expectedDeliveryDate "optional"
        String status "optional"
        String notes "optional"
        ObjectId assignedReceiver_userId FK "ref to User; optional"
        String assignedReceiver_name "optional"
        String assignedReceiver_email "optional"
        DocumentArray items "optional"
        DocumentArray receipts "optional"
        DocumentArray pendingReceipts "optional"
        String createdBy "optional"
        String createdByEmail "optional"
        String approvedBy "optional"
        Date approvedAt "optional"
        String cancelledBy "optional"
        Date cancelledAt "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    Notification {
        ObjectId _id PK
        String type "required"
        String title "required"
        String message "required"
        ObjectId purchaseOrderId FK "ref to PurchaseOrder; optional"
        String purchaseOrderNo "optional"
        StringArray audiences "optional"
        DocumentArray readBy "optional"
        Date resolvedAt "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    LoginActivity {
        ObjectId _id PK
        ObjectId userId FK "ref to User; optional"
        String name "required"
        String email "required"
        String role "required"
        String action "optional"
        String staffId "optional"
        String ipAddress "optional"
        String userAgent "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    SystemAudit {
        ObjectId _id PK
        String module "required"
        String action "required"
        String entityId "optional"
        String entityName "optional"
        String actor "optional"
        String actorEmail "optional"
        String details "optional"
        Mixed changes "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    EmailVerification {
        ObjectId _id PK
        String email "required"
        String otpHash "required"
        Date expiresAt "required"
        Number attempts "optional"
        Date createdAt "optional"
        Date updatedAt "optional"
    }
    ForecastSnapshot {
        ObjectId _id PK
        String dataset "required"
        String source "required"
        String targetDate "required"
        Number predictedSales "required"
        Date generatedAt "required"
        String trainedThrough "required"
        String method "optional"
    }
    Product }o..o| Category : "categoryId"
    Recipe }o..|| Product : "productId"
    Recipe }o..o{ Inventory : "ingredients[].inventoryId"
    Transaction }o..o| Refund : "cancellationRefundId"
    Transaction }o..o{ Product : "cancelledItems[].productId"
    Transaction }o..o{ Refund : "cancelledItems[].refundId"
    Transaction }o..o{ Product : "items[].productId"
    Refund }o..|| Transaction : "transactionId"
    Refund }o..o{ Product : "items[].productId"
    Waste }o..|| Refund : "refundId"
    Waste }o..|| Transaction : "transactionId"
    Waste }o..o{ Inventory : "items[].inventoryId"
    PurchaseOrder }o..o| User : "assignedReceiver.userId"
    PurchaseOrder }o..o{ Inventory : "items[].inventoryId"
    PurchaseOrder }o..o{ Inventory : "receipts[].items[].inventoryId"
    Notification }o..o| PurchaseOrder : "purchaseOrderId"
    LoginActivity }o..o| User : "userId"
